# CertiChain certificate service: optional settings.
# The service reads these as environment variables (it does not load a .env file by itself).
# Example (PowerShell):  $env:PORT=3001; npm start
# Example (bash):        PORT=3001 npm start

# Port of the HTTP API used by web/issue.html (default 3001)
PORT=3001

# Page that every certificate QR code opens. The default is the public GitHub Pages copy:
VERIFY_BASE_URL=https://malak600.github.io/Certificate-verification-check-certificates-with-a-QR-code/web/verify.html
