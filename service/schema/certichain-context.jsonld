{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "id": "@id",
    "type": "@type",
    "certichain": "https://certichain.iku.edu.tr/schema#",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "VerifiableCredential": "https://www.w3.org/2018/credentials#VerifiableCredential",
    "ParticipationCertificate": "certichain:ParticipationCertificate",
    "issuer": {
      "@id": "https://www.w3.org/2018/credentials#issuer",
      "@type": "@id"
    },
    "validFrom": {
      "@id": "https://www.w3.org/2018/credentials#validFrom",
      "@type": "xsd:dateTime"
    },
    "credentialSubject": {
      "@id": "https://www.w3.org/2018/credentials#credentialSubject",
      "@type": "@id"
    },
    "recipientName": {
      "@id": "certichain:recipientName",
      "@type": "xsd:string"
    },
    "recipientEmail": {
      "@id": "certichain:recipientEmail",
      "@type": "xsd:string"
    },
    "event": {
      "@id": "certichain:event",
      "@type": "@id"
    },
    "eventTitle": {
      "@id": "certichain:eventTitle",
      "@type": "xsd:string"
    },
    "eventDate": {
      "@id": "certichain:eventDate",
      "@type": "xsd:string"
    },
    "salt": {
      "@id": "certichain:salt",
      "@type": "xsd:string"
    },
    "wasAttributedTo": {
      "@id": "prov:wasAttributedTo",
      "@type": "@id"
    },
    "wasGeneratedBy": {
      "@id": "prov:wasGeneratedBy",
      "@type": "@id"
    }
  }
}
